---
import { t, routes, contact, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t[lang];
---

<footer class="footer">
  <p class="footer__name">Podoroж</p>
  <ul class="footer__links">
    <li><a class="link-quiet" href={`mailto:${contact.email}`}>{contact.email}</a></li>
    <li><a class="link-quiet" href={contact.spotify} rel="me">Spotify</a></li>
    <li><a class="link-quiet" href={contact.youtube} rel="me">YouTube</a></li>
    <li><a class="link-quiet" href={contact.facebook} rel="me">Facebook</a></li>
  </ul>
  <p class="footer__meta">{c.footerCredit} · © {new Date().getFullYear()} Podoroж</p>
  <p class="footer__legal"><a class="link-quiet" href={routes.privacy[lang]}>{c.footerLegal.privacy}</a></p>
</footer>

<style>
  .footer {
    display: grid;
    gap: 1rem;
    padding: 4rem var(--gutter) 6rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--fg-dim);
  }
  .footer__name {
    color: var(--fg);
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }
  @media (min-width: 48rem) {
    .footer__legal {
      grid-column: 1 / -1;
    }
    .footer {
      grid-template-columns: auto 1fr auto;
      align-items: baseline;
      gap: 2rem;
    }
  }
</style>
