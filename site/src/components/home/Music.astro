---
import { Image } from 'astro:assets';
import cover from '../../assets/album-cover.png';
import { t, tracks, streaming, shop, contact, showFilm, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const c = t[Astro.props.lang];
---

<section id="muzyka" class="music" aria-labelledby="music-title">
  <h2 id="music-title" class="label" data-view="wipe">{c.musicTitle}</h2>

  <div class="music__album">
    <div class="music__frame" data-view>
      <Image src={cover} alt={c.albumAlt} widths={[420, 840]} sizes="(min-width: 60rem) 420px, 100vw" class="music__cover" />
    </div>
    <div class="music__about">
      <h3 class="music__title" data-view="rise">{c.albumTitle}</h3>
      <p class="music__text" data-view="rise">{c.albumText}</p>
      {
        streaming.length > 0 && (
          <div class="music__streaming" data-view="rise">
            <p class="music__small">{c.listenOn}</p>
            <ul>
              {streaming.map((s) => (
                <li>
                  <a href={s.href}>{s.label}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="music__streaming" data-view="rise">
        <p class="music__small">{c.buy.label}</p>
        <ul>
          <li>
            <a href={shop} hreflang="pl">{c.buy.link}</a>
          </li>
        </ul>
      </div>
      <h4 class="music__small">{c.tracklist}</h4>
      <ol class="tracks">
        {
          tracks.map(([name, time], i) => (
            <li data-view="slide">
              <span class="tracks__no">{String(i + 1).padStart(2, '0')}</span>
              <span class="tracks__name">{name}</span>
              <span class="tracks__time">{time}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  {
    showFilm && (
      <div class="film">
        <h3 class="music__small">{c.filmTitle}</h3>
        <a class="film__trigger" href={contact.film} data-yt={contact.filmId} aria-label={c.filmPlay}>
          <img src="/posters/film-desktop.webp" alt="" width="1600" height="900" loading="lazy" decoding="async" />
          <span class="film__play">
            <span class="film__icon" aria-hidden="true" />
            {c.filmPlay}
          </span>
        </a>
        <p class="music__small film__note">
          {c.filmNote} {c.filmCredit}
        </p>
      </div>
    )
  }
</section>

<script>
  // Click-to-load YouTube (no third-party requests or cookies before the click).
  document.querySelectorAll<HTMLAnchorElement>('[data-yt]').forEach((a) => {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${a.dataset.yt}?autoplay=1&rel=0`;
      f.title = a.getAttribute('aria-label') ?? 'YouTube';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      a.replaceWith(f);
      f.focus();
    });
  });
</script>

<style>
  .music {
    display: grid;
    gap: 3rem;
    padding: 7rem var(--gutter) 6rem;
    max-width: 75rem;
    margin: 0 auto;
  }
  .music__album {
    display: grid;
    gap: 2.5rem;
  }
  .music__frame {
    max-width: 26rem;
    overflow: hidden;
  }
  .music__cover {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1);
    transition: filter 700ms var(--ease-out);
  }
  .music__cover:hover {
    filter: none;
  }
  .music__about {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .music__title {
    font-size: var(--step-2);
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .music__text {
    max-width: 52ch;
    color: var(--fg-dim);
  }
  .music__small {
    margin-top: 1rem;
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .music__streaming ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 0.5rem;
  }
  /* The cover opens like a frame: the clip widens while the image settles from a close-up */
  :global(.scrub) .music__frame {
    clip-path: inset(calc((1 - var(--in, 1)) * 18%));
  }
  :global(.scrub) .music__cover {
    scale: calc(1 + (1 - var(--in, 1)) * 0.35);
  }
  .tracks li {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    transition: background-color 200ms var(--ease-out);
  }
  .tracks li:hover {
    background: color-mix(in oklch, var(--fg) 4%, transparent);
  }
  .tracks__no,
  .tracks__time {
    color: var(--fg-dim);
  }

  .film {
    display: grid;
    gap: 1rem;
  }
  .film__trigger,
  .film :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--silver-deep);
  }
  .film__trigger img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 400ms var(--ease-out);
  }
  .film__trigger:hover img {
    opacity: 0.8;
  }
  .film__play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.5rem;
    background: oklch(0.16 0.01 250 / 0.75);
    color: var(--silver-mist);
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .film__icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.45rem 0 0.45rem 0.75rem;
    border-color: transparent transparent transparent currentColor;
  }
  .film__note {
    margin: 0;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (min-width: 60rem) {
    .music__album {
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: 4rem;
    }
    /* The cover holds still while the tracklist scrolls past it */
    .music__frame {
      position: sticky;
      top: 6rem;
      align-self: start;
    }
  }
</style>
