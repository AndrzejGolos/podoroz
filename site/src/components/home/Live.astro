---
import { Image } from 'astro:assets';
import outdoor from '../../assets/live/outdoor.jpg';
import stage from '../../assets/live/stage.jpg';
import { t, concerts, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t[lang];
// Outdoor first, then indoor: the same order as "kameralne i plenerowe" reads in the photos.
const photos = [
  { src: outdoor, alt: c.photoAlts.outdoor },
  { src: stage, alt: c.photoAlts.stage },
];
---

<section id="na-zywo" class="live" aria-labelledby="live-title">
  <div class="live__head">
    <h2 id="live-title" class="label" data-view="wipe">{c.liveTitle}</h2>
    <div class="prose live__text">
      {c.liveText.map((p) => <p data-view="rise">{p}</p>)}
    </div>
  </div>

  {
    concerts.length > 0 && (
      <div class="live__concerts">
        <h3 class="label">{c.concertsTitle}</h3>
        <ul>
          {concerts.map((k) => (
            <li>
              <time datetime={k.date}>{k.date}</time>
              {k.href ? <a href={k.href}>{k.place[lang]}</a> : <span>{k.place[lang]}</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  <div class="live__photos">
    {
      photos.map((p) => (
        <div class="live__photo" data-view>
          <Image src={p.src} alt={p.alt} widths={[640, 1024, 1600]} sizes="(min-width: 48rem) 50vw, 100vw" />
        </div>
      ))
    }
  </div>
</section>

<style>
  .live {
    display: grid;
    gap: 3rem;
    padding: 6rem var(--gutter);
    max-width: 75rem;
    margin: 0 auto;
  }
  .live__head {
    display: grid;
    gap: 2rem;
  }
  .live__text {
    max-width: 58ch;
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .live__concerts ul {
    margin-top: 1.5rem;
  }
  .live__concerts li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line);
  }
  /* Grayscale like the rest of the site; colour returns on hover, as on the album cover */
  .live__photos {
    display: grid;
    gap: 1rem;
  }
  .live__photo {
    overflow: hidden;
  }
  .live__photos :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: grayscale(1) contrast(1.02);
    transition: filter 700ms var(--ease-out);
  }
  .live__photos :global(img:hover) {
    filter: none;
  }
  /* Photos are uncovered from below, then drift slower than the page (parallax) */
  :global(.scrub) .live__photo {
    clip-path: inset(calc((1 - var(--in, 1)) * 100%) 0 0 0);
  }
  :global(.scrub) .live__photos :global(img) {
    scale: 1.15;
    translate: 0 calc((var(--v, 0.5) - 0.5) * -12%);
  }
  @media (min-width: 48rem) {
    .live__photos {
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 1.5rem;
    }
    .live__photo:last-child {
      margin-top: 5rem;
    }
  }
</style>
